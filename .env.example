# Copie para .env (local) ou cadastre na Vercel. Não coloque valores reais aqui.

# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: API Keys
RESEND_API_KEY=
# Remetente com domínio verificado no Resend, ex.: Portal da CPA <cpa@seudominio.com.br>
EMAIL_FROM=

# Caixa que recebe as mensagens do formulário de contato
CPA_EMAIL=

# Endereço público do portal, sem barra no final (usado nos links dos e-mails)
PORTAL_URL=
